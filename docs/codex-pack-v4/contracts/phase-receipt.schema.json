{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/phase-receipt.schema.json",
  "title": "Phase Receipt",
  "type": "object",
  "required": [
    "phase",
    "verdict",
    "commit",
    "tree",
    "tests",
    "evidence",
    "blockers"
  ],
  "properties": {
    "phase": {
      "type": "string",
      "pattern": "^0[0-8]$"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN_BLOCKED"
      ]
    },
    "commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40}$"
    },
    "tree": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40}$"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exitCode"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exitCode": {
            "type": "integer"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
