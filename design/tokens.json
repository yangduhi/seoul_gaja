{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "seoul-gaja-calm-glass",
  "version": "0.1.0",
  "meta": {
    "status": "planning",
    "authority": "design/design.md",
    "notes": "Initial values must be contrast-tested and tuned against deterministic browser captures in Phase 01."
  },
  "viewport": {
    "mobileReference": { "width": 430, "height": 932 },
    "desktopReference": { "width": 1616, "height": 923 },
    "mobileMax": 767,
    "tabletMax": 1199
  },
  "radius": {
    "sheet": 28,
    "card": 24,
    "control": 18,
    "small": 14,
    "pill": 999
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48
  },
  "touch": {
    "minimum": 44,
    "comfortable": 48
  },
  "blur": {
    "surface": 22,
    "control": 16,
    "popover": 28,
    "maximum": 32
  },
  "typography": {
    "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif",
    "display": { "size": 32, "lineHeight": 38, "weight": 700 },
    "title1": { "size": 26, "lineHeight": 33, "weight": 700 },
    "title2": { "size": 21, "lineHeight": 28, "weight": 650 },
    "headline": { "size": 17, "lineHeight": 23, "weight": 650 },
    "body": { "size": 16, "lineHeight": 23, "weight": 400 },
    "callout": { "size": 15, "lineHeight": 21, "weight": 500 },
    "caption": { "size": 13, "lineHeight": 18, "weight": 500 },
    "micro": { "size": 12, "lineHeight": 16, "weight": 500 }
  },
  "motion": {
    "fastMs": 140,
    "standardMs": 220,
    "slowMs": 320,
    "reducedMotionMs": 0
  },
  "layout": {
    "mobilePagePadding": 16,
    "desktopPagePadding": 24,
    "desktopLeftPaneMin": 360,
    "desktopLeftPaneMax": 400,
    "desktopRightPaneMin": 400,
    "desktopRightPaneMax": 460,
    "contentMax": 1600
  },
  "color": {
    "light": {
      "canvas": "#F3F6FB",
      "canvasAlt": "#EEF1F8",
      "textPrimary": "#172033",
      "textSecondary": "#526078",
      "textTertiary": "#6E7A90",
      "glassSurface": "rgba(255,255,255,0.72)",
      "glassControl": "rgba(255,255,255,0.82)",
      "glassBorder": "rgba(255,255,255,0.88)",
      "overlay": "rgba(18,25,41,0.22)",
      "focus": "#345CFF",
      "accent": "#536DFF",
      "accentSoft": "#E5E9FF"
    },
    "dark": {
      "canvas": "#0E1320",
      "canvasAlt": "#151C2B",
      "textPrimary": "#F5F7FC",
      "textSecondary": "#C3CCDC",
      "textTertiary": "#99A6BC",
      "glassSurface": "rgba(25,34,52,0.72)",
      "glassControl": "rgba(35,45,66,0.80)",
      "glassBorder": "rgba(255,255,255,0.14)",
      "overlay": "rgba(0,0,0,0.42)",
      "focus": "#91AAFF",
      "accent": "#8EA2FF",
      "accentSoft": "#273255"
    },
    "congestion": {
      "relaxed": "#2B8A66",
      "normal": "#2877C7",
      "busy": "#D78716",
      "veryBusy": "#D34E4E",
      "unknown": "#7D8798"
    },
    "maturity": {
      "accumulating": "#7D8798",
      "provisional": "#6F70C8",
      "stable": "#5752B8",
      "mature": "#413A9C"
    }
  },
  "semantic": {
    "congestion": {
      "RELAXED": { "labelKo": "여유", "colorToken": "color.congestion.relaxed" },
      "NORMAL": { "labelKo": "보통", "colorToken": "color.congestion.normal" },
      "BUSY": { "labelKo": "약간 붐빔", "colorToken": "color.congestion.busy" },
      "VERY_BUSY": { "labelKo": "붐빔", "colorToken": "color.congestion.veryBusy" },
      "UNKNOWN": { "labelKo": "정보 없음", "colorToken": "color.congestion.unknown" }
    },
    "freshness": ["FRESH", "DELAYED", "STALE", "EXPIRED"],
    "recordState": ["REFRESHED", "CARRIED_FORWARD", "UNAVAILABLE"],
    "historyMaturity": ["ACCUMULATING", "PROVISIONAL", "STABLE", "MATURE"]
  }
}
